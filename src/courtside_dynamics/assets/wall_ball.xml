<mujoco model="wall_ball">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true" />
    <option integrator="RK4" timestep="0.002" />
    <size nconmax="500" njmax="1000" />
    <default>
        <joint armature="0.1" damping="1" limited="true" />
        <geom condim="3" density="1000" friction="1 0.5 0.5" margin="0.001" rgba="0.8 0.8 0.8 1" />
    </default>
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" mark="none" />
        <material name="grid" texture="grid" texrepeat="3 3" texuniform="true" reflectance=".2" />
    </asset>
    <worldbody>
        <light diffuse=".8 .8 .8" pos="0 0 5" specular="0.1 0.1 0.1" />
        <camera name="side" pos="0 -8 3" xyaxes="1 0 0 0 1 2" />
        <geom name="floor" pos="0 0 0" size="8 6 0.1" type="plane" material="grid" />

        <!-- Court markings. Sites only: MuJoCo sites never generate
             contacts, so these are render-only and cannot perturb
             physics, observations, or rewards. Static geography lives
             here; the preset-dependent markers (paddle lane, home,
             fence, serve drop line) are placeholders whose x position,
             width, and visibility WallBallEnv rewrites from its
             resolved kwargs at reset (_refresh_court_markers). Line
             heights are staggered slightly above the floor to avoid
             z-fighting. -->
        <!-- Fixed geography: bold white lines at the wall base
             (x=3.9) and the deepest paddle reach ("baseline",
             x=-4.7); faint 1 m coordinate ticks between them. -->
        <site name="court_line_wall_base" type="box" pos="3.9 0 0.006" size="0.03 5 0.002" rgba="1 1 1 0.8" />
        <site name="court_line_baseline" type="box" pos="-4.7 0 0.006" size="0.03 5 0.002" rgba="1 1 1 0.8" />
        <site name="court_tick_xm4" type="box" pos="-4 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.22" />
        <site name="court_tick_xm3" type="box" pos="-3 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.22" />
        <site name="court_tick_xm2" type="box" pos="-2 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.22" />
        <site name="court_tick_xm1" type="box" pos="-1 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.22" />
        <site name="court_tick_x0" type="box" pos="0 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.35" />
        <site name="court_tick_xp1" type="box" pos="1 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.22" />
        <site name="court_tick_xp2" type="box" pos="2 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.22" />
        <site name="court_tick_xp3" type="box" pos="3 0 0.004" size="0.01 5 0.002" rgba="1 1 1 0.22" />
        <!-- Preset-dependent markers (positions rewritten by the env):
             cyan strip + edge lines = paddle action lane, yellow line =
             paddle home, orange lines = paddle fence (hidden unless a
             fence is set), warm line = serve drop x. -->
        <site name="court_lane_strip" type="box" pos="-1.7 0 0.002" size="2.5 5 0.001" rgba="0.2 0.8 0.9 0.15" />
        <site name="court_line_lane_min" type="box" pos="-4.7 0 0.008" size="0.02 5 0.002" rgba="0.25 0.9 1 0.7" />
        <site name="court_line_lane_max" type="box" pos="0.3 0 0.008" size="0.02 5 0.002" rgba="0.25 0.9 1 0.7" />
        <site name="court_line_home" type="box" pos="-1.7 0 0.01" size="0.02 5 0.002" rgba="0.95 0.85 0.2 0.85" />
        <site name="court_line_fence_min" type="box" pos="-4.7 0 0.012" size="0.02 5 0.002" rgba="1 0.55 0.15 0.85" />
        <site name="court_line_fence_max" type="box" pos="0.3 0 0.012" size="0.02 5 0.002" rgba="1 0.55 0.15 0.85" />
        <site name="court_line_serve" type="box" pos="1.0 0 0.006" size="0.02 5 0.002" rgba="1 0.4 0.45 0.6" />

        <body name="wall" pos="4 0 1.5">
            <site name="wall_sensor" pos="-0.06 0 0" size="0.05 5 1.5" type="box" rgba="1 0 0 0.15" />
            <geom name="wall_geom" size="0.1 5 1.5" type="box" rgba="0.7 0.7 0.9 1" />
        </body>

        <!-- Face-only paddle with a fixed 10-degree upward pitch. Its
             three slide joints translate the face directly; there is no
             grip, shaft, yaw, or pitch degree of freedom that can intercept
             the ball. The anchor moves 0.3 m forward from the old handle
             origin so qpos=0 and every joint limit preserve the old
             face-centre workspace exactly. -->
        <!-- Slide damping 5 is the open/volley calibration; the
             position servo's kv acts inside the +/-100 N force clamp,
             so a pegged actuator accelerates until passive joint
             damping balances it (terminal velocity 100/damping).
             Presets that need slower swings override it per-instance
             via WallBallEnv's paddle_joint_damping kwarg instead of
             editing this shared asset. -->
        <body name="paddle_base" pos="-1.7 0 1.2">
            <joint name="paddle_slide_x" type="slide" axis="1 0 0" range="-3 2" damping="5" />
            <joint name="paddle_slide_y" type="slide" axis="0 1 0" range="-3 3" damping="5" />
            <!-- Lower bound -0.9 puts the face's bottom edge at
                 z=0.05: low enough to address a rolling ball (centre
                 z=0.07) while still clearing the floor. At the old
                 -0.8 the face bottomed out at z=0.15 and a grounded
                 ball was unreachable. -->
            <joint name="paddle_slide_z" type="slide" axis="0 0 1" range="-0.9 2" damping="5" />
            <body name="paddle_head" pos="0 0 0" euler="0 -10 0">
                <site name="paddle_sensor" pos="0 0 0" size="0.02 0.2 0.25" type="box" rgba="0 1 0 0.15" />
                <!-- Keep the old complete racket mass (face + grip + shaft)
                     so this interface change does not also change collision
                     inertia. The face is the only paddle collision geom. -->
                <geom name="paddle_face" type="box" pos="0 0 0" size="0.02 0.2 0.25" rgba="0.9 0.9 0.2 1" solref="0.01 0.5" mass="0.35" />
            </body>
        </body>

        <!-- Tennis ball. Mass is ~57g like a regulation ball. The
             joint must override the default damping=1 / armature=0.1
             — those are sized for jointed paddle DOFs, not a ball
             flying through the air, where they'd act as drag.

             priority="1" makes the ball's contact parameters win
             outright against the wall/floor/paddle instead of being
             averaged with their critically-damped defaults — without
             it the effective damping ratio is ~0.85 and the ball is
             nearly perfectly inelastic (measured e_floor=0.13,
             e_wall=0.00), so it dies on the first wall hit and rallies
             beyond one exchange are physically impossible.
             solref="0.01 0.15" measures e_floor≈0.71 on a 1 m drop
             test, matching a regulation ball on hard court (~0.73).
             Do not push dampratio below ~0.1: the soft contact then
             *injects* energy (e > 1) and the sim goes unstable. -->
        <body name="ball" pos="1.0 0 1.3">
            <joint name="ball_x" type="free" limited="false" damping="0" armature="0" />
            <geom name="ball_geom" type="sphere" size="0.07" rgba="1 0.5 0 1" mass="0.057" friction="0.3 0.1 0.1" priority="1" solref="0.01 0.15" />
        </body>
    </worldbody>
    <actuator>
        <!-- Absolute joint-position targets. kp=300 with actuator kv=18
             plus joint damping=5 is approximately critically damped for
             the 0.35 kg face + 0.1 armature. The force cap preserves the
             old slide motors' +/-100 N authority. -->
        <position name="paddle_target_x" joint="paddle_slide_x" kp="300" kv="18" ctrlrange="-3 2" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
        <position name="paddle_target_y" joint="paddle_slide_y" kp="300" kv="18" ctrlrange="-3 3" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
        <position name="paddle_target_z" joint="paddle_slide_z" kp="300" kv="18" ctrlrange="-0.9 2" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
    </actuator>
    <sensor>
        <touch name="paddle_touch" site="paddle_sensor" />
        <touch name="wall_touch" site="wall_sensor" />
    </sensor>
</mujoco>
