<mujoco model="paddle_court">
    <!-- PaddleTennis prototype court, frozen by the P0-P2 probe battery
         (docs/paddle_tennis_probes_20260802.md): half-length 6.5 m,
         regulation 0.914 m net at x = 0, singles width +/-4.115 m.
         Ball and paddles are the wall-ball calibrations VERBATIM
         (same solver options, contact params, servo gains, +/-10 deg
         face pitch); slide damping 8 is baked in, the value every
         P0-P2 number was measured at (wall_ball.xml's default 5 is
         the open/volley calibration the probes did not use). Do not
         retune anything here without a probe: the paddle's terminal
         velocity (100 N / damping) IS the era's difficulty placement.

         Collision categories follow envs/_tennis_physics.py so
         TennisSceneContactIndex resolves this scene without robots:
         COURT=1, BALL=2, NET=4, RACKET=8. Racket geoms carry the
         player_a_racket_/player_b_racket_ prefixes the index expects.

         Side A plays x < 0 and faces +x; side B is the exact
         180-degree court rotation. -->
    <compiler angle="degree" coordinate="local" inertiafromgeom="true" />
    <option integrator="RK4" timestep="0.002" />
    <size nconmax="500" njmax="1000" />
    <default>
        <joint armature="0.1" damping="1" limited="true" />
        <geom condim="3" density="1000" friction="1 0.5 0.5" margin="0.001" rgba="0.8 0.8 0.8 1" />
    </default>
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" mark="none" />
        <material name="grid" texture="grid" texrepeat="3 3" texuniform="true" reflectance=".2" />
    </asset>
    <worldbody>
        <light diffuse=".8 .8 .8" pos="0 0 6" specular="0.1 0.1 0.1" />
        <camera name="side" pos="0 -11 4" xyaxes="1 0 0 0 1 2" />

        <!-- The physical surface extends past the lines (an out ball
             still bounces); legality is judged by landing position via
             CourtGeometry(6.5, 4.115), not by surface extent. -->
        <geom name="court_surface" pos="0 0 0" size="9 6 0.1" type="plane" material="grid" contype="1" conaffinity="2" />

        <!-- Court lines, render-only sites (court_* naming so a future
             styled env can derive visibility lists from the model the
             way WallBallEnv now does). -->
        <site name="court_line_baseline_a" type="box" pos="-6.5 0 0.006" size="0.03 4.115 0.002" rgba="1 1 1 0.8" />
        <site name="court_line_baseline_b" type="box" pos="6.5 0 0.006" size="0.03 4.115 0.002" rgba="1 1 1 0.8" />
        <site name="court_line_side_left" type="box" pos="0 -4.115 0.006" size="6.5 0.03 0.002" rgba="1 1 1 0.8" />
        <site name="court_line_side_right" type="box" pos="0 4.115 0.006" size="6.5 0.03 0.002" rgba="1 1 1 0.8" />

        <!-- Regulation-height net. A thin box the full playable width;
             posts are cosmetic sites. The ball's priority contact
             params win against it, like every other surface. -->
        <body name="net">
            <geom name="net_panel" type="box" pos="0 0 0.457" size="0.02 4.115 0.457" rgba="0.15 0.15 0.2 0.85" contype="4" conaffinity="2" />
            <site name="net_post_left" type="cylinder" pos="0 -4.115 0.457" size="0.03 0.457" rgba="0.9 0.9 0.9 1" />
            <site name="net_post_right" type="cylinder" pos="0 4.115 0.457" size="0.03 0.457" rgba="0.9 0.9 0.9 1" />
        </body>

        <!-- Side A paddle: the wall-ball paddle verbatim (gains, mass,
             face size, +/-10 deg pitch toward its net direction),
             workspace bounded to its own half. Slide ranges are chosen
             so the world-space x workspace is (-6.4, -0.1): 0.1 m
             inside each end of the frozen 6.5 m half-court (net
             clearance at the front; the deepest 0.1 m at the baseline
             is deliberately out of reach).
             y range +/-3 is the wall-ball value VERBATIM (probes ran
             it); corners beyond |y|=3 are unreachable by design until
             a probe says otherwise. PROVISIONAL pending the
             env-definition freeze. -->
        <body name="player_a_paddle_base" pos="-1.7 0 1.2">
            <joint name="player_a_slide_x" type="slide" axis="1 0 0" range="-4.7 1.6" damping="8" />
            <joint name="player_a_slide_y" type="slide" axis="0 1 0" range="-3 3" damping="8" />
            <joint name="player_a_slide_z" type="slide" axis="0 0 1" range="-0.9 2" damping="8" />
            <body name="player_a_head" pos="0 0 0" euler="0 -10 0">
                <geom name="player_a_racket_face" type="box" pos="0 0 0" size="0.02 0.2 0.25" rgba="0.9 0.9 0.2 1" solref="0.01 0.5" mass="0.35" contype="8" conaffinity="2" />
            </body>
        </body>

        <!-- Side B: the exact 180-degree court rotation of side A. -->
        <body name="player_b_paddle_base" pos="1.7 0 1.2">
            <joint name="player_b_slide_x" type="slide" axis="1 0 0" range="-1.6 4.7" damping="8" />
            <joint name="player_b_slide_y" type="slide" axis="0 1 0" range="-3 3" damping="8" />
            <joint name="player_b_slide_z" type="slide" axis="0 0 1" range="-0.9 2" damping="8" />
            <body name="player_b_head" pos="0 0 0" euler="0 10 0">
                <geom name="player_b_racket_face" type="box" pos="0 0 0" size="0.02 0.2 0.25" rgba="0.2 0.6 0.9 1" solref="0.01 0.5" mass="0.35" contype="8" conaffinity="2" />
            </body>
        </body>

        <!-- The wall-ball ball verbatim: mass, restitution calibration,
             priority contact params (see wall_ball.xml for the full
             rationale). Joint named ball_free for the tennis-events
             sampler default. conaffinity 13 = COURT|NET|RACKET. -->
        <body name="ball" pos="-3.25 0 1.3">
            <joint name="ball_free" type="free" limited="false" damping="0" armature="0" />
            <geom name="ball_geom" type="sphere" size="0.07" rgba="1 0.5 0 1" mass="0.057" friction="0.3 0.1 0.1" priority="1" solref="0.01 0.15" contype="2" conaffinity="13" />
        </body>
    </worldbody>
    <actuator>
        <!-- Wall-ball position servos verbatim: kp 300 / kv 18 inside
             the +/-100 N force clamp; with slide damping 8 the
             terminal velocity is the probe-measured ~12.5 m/s power
             ceiling. -->
        <position name="player_a_target_x" joint="player_a_slide_x" kp="300" kv="18" ctrlrange="-4.7 1.6" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
        <position name="player_a_target_y" joint="player_a_slide_y" kp="300" kv="18" ctrlrange="-3 3" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
        <position name="player_a_target_z" joint="player_a_slide_z" kp="300" kv="18" ctrlrange="-0.9 2" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
        <position name="player_b_target_x" joint="player_b_slide_x" kp="300" kv="18" ctrlrange="-1.6 4.7" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
        <position name="player_b_target_y" joint="player_b_slide_y" kp="300" kv="18" ctrlrange="-3 3" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
        <position name="player_b_target_z" joint="player_b_slide_z" kp="300" kv="18" ctrlrange="-0.9 2" ctrllimited="true" forcerange="-100 100" forcelimited="true" />
    </actuator>
</mujoco>
